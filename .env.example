# Copy this file to server/.env and fill in real values. Never commit server/.env.

# Roboflow hosted inference API (free tier) - gym equipment detection
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=

# Text-to-speech provider for the voice mentor (pick one)
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=

# YouTube Data API v3 - exercise demo video search
YOUTUBE_API_KEY=

# Server port
PORT=4000
